/* Restaurant Loop — Level Editor styling.
   Ported from the Twisted Tangle level creator's dark ImGui-inspired theme
   (#1A1A1A base, #4296F7 blue accent) so future editor windows in this project
   share the same look. Only the pieces the Conveyor Grid tool needs so far. */

.rl-root {
    flex-grow: 1;
}

.rl-app-container {
    flex-direction: column;
    flex-grow: 1;
    background-color: #1A1A1A;
    padding: 8px;
}

/* ── Topbar ──────────────────────────────────────────────────────────────── */

.rl-topbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 36px;
    padding: 4px 8px;
    margin-bottom: 6px;
    background-color: #141414;
    border-radius: 3px;
    border-width: 1px;
    border-color: #2E2E2E;
    flex-wrap: wrap;
}

.rl-topbar__sep {
    width: 1px;
    height: 20px;
    background-color: #404040;
    margin-left: 8px;
    margin-right: 12px;
}

/* ── Buttons ─────────────────────────────────────────────────────────────── */

.rl-btn {
    height: 24px;
    border-radius: 3px;
    -unity-font-style: bold;
    margin-right: 4px;
    background-color: #2A2A2A;
    color: #AAAAAA;
    border-width: 1px;
    border-color: #3A3A3A;
}

.rl-btn:hover {
    border-color: #4296F7;
    color: #EEEEEE;
}

.rl-btn--primary {
    background-color: #1E3050;
    color: #4296F7;
    border-width: 1px;
    border-color: #4296F7;
}

.rl-btn--danger {
    background-color: #3A1A1A;
    color: #E55353;
    border-width: 1px;
    border-color: #CC3333;
}

/* ── Numeric fields ──────────────────────────────────────────────────────── */

.rl-num {
    flex-grow: 0;
    margin-right: 10px;
}

.rl-num .unity-base-field__label {
    min-width: 0;
    width: 56px;
    margin-right: 2px;
    color: #AAAAAA;
    -unity-font-style: normal;
}

.rl-num .unity-base-text-field__input {
    min-width: 0;
    width: 46px;
    background-color: #252525;
    border-color: #404040;
    border-radius: 2px;
    color: #EEEEEE;
    -unity-font-style: normal;
}

.rl-num .unity-base-text-field__input:focus {
    border-color: #4296F7;
    border-width: 1px;
}

/* ── Canvas ──────────────────────────────────────────────────────────────── */

.rl-canvas-host {
    align-items: flex-start;
    justify-content: flex-start;
    padding: 16px;
    background-color: #111111;
    border-radius: 3px;
    min-height: 200px;
}

.rl-canvas {
    align-self: flex-start;
}

/* ── Misc text ───────────────────────────────────────────────────────────── */

.rl-status-label {
    color: #AAAAAA;
    font-size: 11px;
    margin-top: 6px;
}

/* ── Rows / sections ─────────────────────────────────────────────────────── */

.rl-row {
    flex-direction: row;
    align-items: center;
}

.rl-row--wrap {
    flex-wrap: wrap;
}

.rl-section {
    margin-top: 10px;
    margin-bottom: 4px;
    padding: 6px;
    border-radius: 3px;
    background-color: #202020;
    border-left-width: 2px;
    border-left-color: #4296F7;
}

.rl-section__header {
    -unity-font-style: bold;
    margin-bottom: 6px;
    color: #CCCCCC;
}

/* ── Mode / tool buttons ─────────────────────────────────────────────────── */

.rl-tool {
    height: 24px;
    min-width: 60px;
    margin-right: 4px;
    border-radius: 3px;
    border-width: 1px;
    border-color: #3A3A3A;
    background-color: #2A2A2A;
    color: #AAAAAA;
}

.rl-tool--active {
    border-color: #4296F7;
    border-width: 1px;
    background-color: #1E3050;
    color: #4296F7;
}

/* ── Palette swatches ────────────────────────────────────────────────────── */

.rl-palette-swatch {
    width: 36px;
    height: 32px;
    margin-right: 4px;
    margin-bottom: 4px;
    border-radius: 5px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.4);
    padding: 0;
    font-size: 18px;
    -unity-font-style: normal;
}

.rl-palette-swatch--selected {
    border-width: 3px;
    border-color: #FFFFFF;
}

